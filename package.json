{
  "name": "hypermedia-agent-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thesis prototype: a fixed generic agent (a/) over hypermedia sites (b1/, b2/ ...). One shared toolchain, one self-contained folder per instance.",
  "scripts": {
    "b1:dev": "tsx watch b1/server.ts",
    "b1:start": "tsx b1/server.ts",
    "b1:check": "tsx b1/check.ts",
    "b1:tasks": "tsx b1/tasks.ts",
    "a:run": "tsx a/run.ts",
    "a:check": "tsx a/check.ts",
    "exp:run": "tsx exp/run.ts",
    "exp:report": "tsx exp/report.ts",
    "exp:check-judges": "tsx exp/check-judges.ts",
    "exp:check-mcp": "tsx exp/check-mcp.ts",
    "b1:mcp": "tsx b1/mcp.ts",
    "typecheck": "tsc --noEmit",
    "exp:elicitation": "tsx exp/elicitation-scan.ts",
    "exp:figures": "tsx exp/figures.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.2",
    "linkedom": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
